msgid "TCP-001"
msgstr "TCP-001"

#: src/part5-advanced/troubleshooting.md:438
msgid "Buffer overflow"
msgstr "Pufferüberlauf"

#: src/part5-advanced/troubleshooting.md:438
msgid "Enable `memory_optimization`, reduce `max_tcp_buffers`"
msgstr "`memory_optimization` aktivieren, `max_tcp_buffers` reduzieren"

#: src/part5-advanced/troubleshooting.md:438
msgid "TCP-002"
msgstr "TCP-002"

#: src/part5-advanced/troubleshooting.md:439
msgid "Assembly timeout"
msgstr "Assemblierungs-Timeout"

#: src/part5-advanced/troubleshooting.md:439
msgid "Increase `tcp_stream_timeout`"
msgstr "`tcp_stream_timeout` erhöhen"

#: src/part5-advanced/troubleshooting.md:439
msgid "TCP-003"
msgstr "TCP-003"

#: src/part5-advanced/troubleshooting.md:440
