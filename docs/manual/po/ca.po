msgid "Invalid SIP format"
msgstr "Format SIP no vàlid"

#: src/part5-advanced/troubleshooting.md:440
msgid "TCP-004"
msgstr "TCP-004"

#: src/part5-advanced/troubleshooting.md:441
msgid "Resource exhaustion"
msgstr "Esgotament dels recursos"

#: src/part5-advanced/troubleshooting.md:441
msgid "Restart with `tcp_performance_mode: memory`"
msgstr "Reinicieu amb `tcp_performance_mode: memory`"

#: src/part5-advanced/troubleshooting.md:441
msgid "TCP-005"
msgstr "TCP-005"

#: src/part5-advanced/troubleshooting.md:443
msgid "Distributed Connectivity"
msgstr "Connectivitat distribuïda"

#: src/part5-advanced/troubleshooting.md:445
msgid ""
"These issues affect hunter-to-processor and processor-to-processor "
"communication. See [Chapter 6](../part3-distributed/architecture.md) for the "
