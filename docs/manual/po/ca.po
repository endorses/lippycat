msgstr "Go (`tls.Config.KeyLogWriter`), Python, Node.js"

#: src/part5-advanced/security.md:523
msgid "Languages"
msgstr "Llenguatges"

#: src/part5-advanced/security.md:523
msgid "Native API or env var"
msgstr "API nativa o variable d'entorn"

#: src/part5-advanced/security.md:525
msgid "CLI Usage"
msgstr "Ús de la CLI"

#: src/part5-advanced/security.md:527
msgid "Point lippycat at a key log file produced by the target application:"
msgstr ""
"Indiqueu a lippycat un fitxer de registre de claus generat per l'aplicació "
"de destinació:"

