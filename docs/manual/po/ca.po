msgid "Enable `memory_optimization`, reduce `max_tcp_buffers`"
msgstr "Activeu `memory_optimization`, reduïu `max_tcp_buffers`"

#: src/part5-advanced/troubleshooting.md:438
msgid "TCP-002"
msgstr "TCP-002"

#: src/part5-advanced/troubleshooting.md:439
