msgstr "Apache 2.4.49+, Caddy v2.6+, nginx Plus R33+"

#: src/part5-advanced/security.md:520
msgid "Web servers"
msgstr "Servidors web"

#: src/part5-advanced/security.md:520
msgid "`SSLKEYLOGFILE` env var or directive"
msgstr "Variable d'entorn o directiva `SSLKEYLOGFILE`"

#: src/part5-advanced/security.md:521
msgid "Browsers"
msgstr "Navegadors"

#: src/part5-advanced/security.md:521
msgid "Firefox, Chrome/Chromium"
msgstr "Firefox, Chrome/Chromium"

#: src/part5-advanced/security.md:521 src/part5-advanced/security.md:522
msgid "`SSLKEYLOGFILE` env var"
msgstr "Variable d'entorn `SSLKEYLOGFILE`"

